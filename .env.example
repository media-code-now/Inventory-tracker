# Browser-visible build variables: use the production project URL and publishable/anon key.
# Set both for production; leave both blank only for the isolated demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# All owner credentials, SMTP secrets, and service-role keys belong in trusted CLI/Edge environments.
# Optional disposable-project verification values (never prefix with NEXT_PUBLIC_):
# STOCKROOM_TEST_ALLOW_WRITES=disposable-project
# STOCKROOM_TEST_ADMIN_EMAIL=
# STOCKROOM_TEST_ADMIN_PASSWORD=
# STOCKROOM_TEST_STAFF_EMAIL=
# STOCKROOM_TEST_STAFF_PASSWORD=
# STOCKROOM_TEST_VIEWER_EMAIL=
# STOCKROOM_TEST_VIEWER_PASSWORD=
# STOCKROOM_TEST_UNINVITED_EMAIL=
# STOCKROOM_TEST_UNINVITED_PASSWORD=
