# Browser-visible staff Auth variables: use the identity provider project URL and publishable/anon key.
# Set both for staff sign-in. Missing Auth configuration never enables demo inventory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# All owner credentials, SMTP secrets, and service-role keys belong in trusted server/CLI environments.
# Optional disposable-project verification values (never prefix with NEXT_PUBLIC_):
# STOCKROOM_TEST_ALLOW_WRITES=disposable-project
# STOCKROOM_TEST_ADMIN_EMAIL=
# STOCKROOM_TEST_ADMIN_PASSWORD=
# STOCKROOM_TEST_STAFF_EMAIL=
# STOCKROOM_TEST_STAFF_PASSWORD=
# STOCKROOM_TEST_VIEWER_EMAIL=
# STOCKROOM_TEST_VIEWER_PASSWORD=
# STOCKROOM_TEST_UNINVITED_EMAIL=
# STOCKROOM_TEST_UNINVITED_PASSWORD=

# Server-only office gate. Never prefix any of these with NEXT_PUBLIC_.
# Required at runtime, including development. Use HTTPS (localhost is allowed in dev).
OFFICE_PASSWORD=
OFFICE_SESSION_SECRET=
OFFICE_APP_ORIGIN=https://inventory.example.com
OFFICE_SESSION_TTL_SECONDS=28800
SUPABASE_SERVICE_ROLE_KEY=

# Neon PostgreSQL. neon deploy writes these to ignored .env.local.
# App requests use the pooled URL; migrations use the direct/unpooled URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Existing Supabase variables are now ONLY for staff Auth and invitation email.
# Initial trusted-owner admin setup (after creating/verifying the account in staff Auth):
NEON_ADMIN_USER_ID=
NEON_ADMIN_NAME=
