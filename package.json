{
  "name": "office-inventory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/check-public-config.mjs",
    "predev": "node scripts/check-public-config.mjs --development",
    "test:access": "node --test scripts/test-invite-handler.cjs scripts/test-public-config.cjs",
    "test:database": "sh scripts/test-database.sh",
    "test:inventory": "node --test scripts/test-inventory-filters.cjs",
    "test:realtime": "node --test scripts/test-live-inventory.cjs",
    "verify:live": "node scripts/verify-live-sessions.cjs",
    "build:production": "node scripts/check-public-config.mjs --production && next build",
    "release:check": "node scripts/release-check.mjs",
    "release:demo": "node scripts/release-check.mjs --demo",
    "test:dashboard": "node --test scripts/test-dashboard.cjs",
    "test:csv": "node --test scripts/test-csv-reports.cjs",
    "verify:office": "node scripts/verify-office.cjs",
    "test:operations": "node --test scripts/test-diagnostics-focus.cjs",
    "test:office": "node --test scripts/test-office-gate.cjs",
    "start": "next start",
    "verify:office-http": "node scripts/verify-office-http.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tailwindcss/postcss": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
